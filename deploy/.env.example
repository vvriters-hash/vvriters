# Скопировать в /opt/vvriters/.env и заполнить. Права: chmod 600 /opt/vvriters/.env
# Никогда не отправляйте ключи в чат и не коммитьте этот файл с ключами.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SCRAPECREATORS_API_KEY=

# Модели (по умолчанию как в ТЗ). Для сравнения качества можно поставить claude-opus-5 или claude-haiku-4-5.
MODEL_MAIN=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5
MODEL_VIDEO=claude-sonnet-5
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Ресурсы сервера: 2 vCPU / 4 ГБ — не больше 2 роликов параллельно.
VIDEO_CONCURRENCY=2
FRAMES_PER_VIDEO=8
MAX_COMMENTS=150

# Страница с отчётами: адрес и вход по паролю.
SITE_ADDRESS=152-53-17-135.sslip.io
REPORTS_USER=vvriters
# Хэш пароля (см. deploy/README.md, шаг 4). Обязательно в одинарных кавычках!
REPORTS_PASSWORD_HASH=''

# MOCK=1 — тестовый прогон без ключей на выдуманных данных.
MOCK=0
